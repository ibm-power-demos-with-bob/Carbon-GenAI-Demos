apiVersion: v1
kind: Pod
metadata:
  name: "invoice-review-{{ .InstanceSlug }}"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
  annotations:
    # One container, one port, serving both the browser UI (/) and the API (/api/*).
    ai-services.io/routes: "8080:invoice-review-{{ .InstanceSlug }}:ui,8080:invoice-review-{{ .InstanceSlug }}:api"
spec:
  restartPolicy: always
  containers:
    - name: invoice-review
      # Image is built locally on the VM, never pulled.
      image: "{{ .Values.invoice.image }}"
      imagePullPolicy: Never
      env:
        - name: PORT
          value: "8080"
        - name: LLM_ENDPOINT
          value: "http://{{ .Values.llm.host }}:{{ .Values.llm.port }}"
        - name: LLM_MODEL
          value: "{{ .Values.llm.model }}"
        - name: LOG_LEVEL
          value: "{{ .Values.invoice.log_level }}"
      resources:
        requests:
          memory: "128Mi"
        limits:
          memory: "256Mi"
      ports:
        - containerPort: 8080
          protocol: TCP
      livenessProbe:
        httpGet:
          path: /health
          port: 8080
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
      readinessProbe:
        httpGet:
          path: /health
          port: 8080
        initialDelaySeconds: 5
        periodSeconds: 10
        timeoutSeconds: 3
        failureThreshold: 3
